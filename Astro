                            if pHighlight and pHighlight.FillColor == Color3.fromRGB(255, 40, 40) then
                                isRedTeammate = true
                            end
                            
                            if not isRedTeammate then
                                local pRoot = pl.Character.HumanoidRootPart
                                local dst = (hrp.Position - pRoot.Position).Magnitude
                                if dst < minDst then
                                    minDst = dst
                                    nearestTarget = pRoot
                                end
                            end
                        end
                    end
                    
                    if nearestTarget and nearestTarget.Parent then
                        hrp.CFrame = nearestTarget.CFrame * CFrame.new(0, 0, 2.0)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        pcall(function() knife:Activate() end)
                    end
                    task.wait(0.1)
                    return
                end

                -- رصد القاتل وإذا اقترب بـ 28 متر -> صعود قوي للأعلى لحد 100 متر
                local murdererHRP = nil
                for _, pl in pairs(_0g2:GetPlayers()) do
                    if pl ~= _0p1 and pl.Character then
                        local pChar = pl.Character
                        local pBackpack = pl.Backpack
                        if pChar:FindFirstChild("Knife") or (pBackpack and pBackpack:FindFirstChild("Knife")) then
                            if pChar:FindFirstChild("HumanoidRootPart") then
                                murdererHRP = pChar.HumanoidRootPart
                                break
                            end
                        end
                    end
                end

                if murdererHRP then
                    local distToMurderer = (hrp.Position - murdererHRP.Position).Magnitude
                    if distToMurderer <= 28.0 then
                        sleepUndergroundPos = nil
                        for _, part in pairs(myChar:GetDescendants()) do
                            if part:IsA("BasePart") then part.CanCollide = false end
                        end
                        
                        for i = 1, 5 do
                            hrp.CFrame = hrp.CFrame + Vector3.new(0, 25, 0)
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                            task.wait(0.05)
                        end
                        
                        while murdererHRP and murdererHRP.Parent and (hrp.Position - murdererHRP.Position).Magnitude < 40.0 and getgenv().AutoFarmCandiesActive do
                            for _, part in pairs(myChar:GetDescendants()) do
                                if part:IsA("BasePart") then part.CanCollide = false end
                            end
                            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            task.wait(0.1)
                        end
                        return
                    end
                end

                -- البحث الدقيق عن الكانديز والكوينز الحقيقية حصرياً (مع استبعاد تام لأي لاعب أو شخصيات زي BXM)
                local nearestPart = nil
                local shortestDist = math.huge

                for _, obj in pairs(_0g7:GetDescendants()) do
                    if not getgenv().AutoFarmCandiesActive then break end
                    
                    -- نتأكد أن الكائن ليس لاعباً أو شخصية في السيرفر
                    local isPlayer = false
                    for _, pl in pairs(_0g2:GetPlayers()) do
                        if pl.Character and (obj == pl.Character or obj:IsDescendantOf(pl.Character)) then
                            isPlayer = true
                            break
                        end
                    end

                    if not isPlayer then
                        local objName = string.lower(obj.Name)
                        if objName == "coin" or objName == "coin_server" or objName == "candy" or objName == "candy_server" or string.find(objName, "coin") or string.find(objName, "candy") then
                            local targetPart = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                            if targetPart and targetPart.Transparency < 1 then
                                local pos = targetPart.Position
                                if pos.Y > 0 and pos.Y < 300 then
                                    local dist = (hrp.Position - pos).Magnitude
                                    if dist < shortestDist then
                                        shortestDist = dist
                                        nearestPart = targetPart
                                    end
                                end
                            end
                        end
                    end
                end

                if nearestPart and nearestPart.Parent then
                    -- إذا وجدت كانديز حقيقية: يستيقظ ويتحرك لجمعها فوراً
                    sleepUndergroundPos = nil
                    hum.PlatformStand = false
                    for _, part in pairs(myChar:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end

                    local startPos = hrp.Position
                    local rawTargetPos = nearestPart.Position
                    local targetPos = Vector3.new(rawTargetPos.X, rawTargetPos.Y + 0.5, rawTargetPos.Z)
                    
                    local distance = (startPos - targetPos).Magnitude
                    local userSpeed = math.clamp(getgenv().CustomFarmSpeed or 20, 1, 100)
                    local duration = math.clamp(distance / userSpeed, 0.1, 4.0)
                    
                    local startTime = tick()
                    while (tick() - startTime) < duration and getgenv().AutoFarmCandiesActive and nearestPart.Parent do
                        local alpha = (tick() - startTime) / duration
                        hrp.CFrame = CFrame.new(startPos:Lerp(targetPos, alpha))
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        _0g3.RenderStepped:Wait()
                    end
                    
                    hrp.CFrame = CFrame.new(targetPos)
                    task.wait(0.04)
                    
                    if not nearestPart.Parent or nearestPart.Transparency >= 1 then
                        getgenv().CollectedCandies = (getgenv().CollectedCandies or 0) + 1
                    end
                else
                    -- إذا خلصت كل الكانديز: ينزل تحت الأرض وينام (منسدح أفقي وثابت تماماً بدون ملاحقة أي شخص)
                    for _, part in pairs(myChar:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                    hum.PlatformStand = true

                    if not sleepUndergroundPos then
                        local currentPos = hrp.Position
                        sleepUndergroundPos = Vector3.new(currentPos.X, currentPos.Y - 3.2, currentPos.Z)
                    end

                    -- وضعية النوم الثابتة تحت الأرض
                    hrp.CFrame = CFrame.new(sleepUndergroundPos) * CFrame.Angles(math.rad(90), 0, 0)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    task.wait(0.1)
                end
            end)
            task.wait(0.02)
        end
        pcall(function()
            local myChar = _0p1.Character
            local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
            for _, part in pairs(myChar:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end)
    end)
end)

